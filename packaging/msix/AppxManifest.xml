<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for VaultType as a Windows 11 passkey plugin provider.
  The Identity Publisher must match the signing certificate's Subject exactly.
  The com:ExeServer Class Id must match PasskeyIds.ClsidString.
  Windows launches "VaultType.exe -PluginActivated" to serve the IPluginAuthenticator COM object.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  IgnorableNamespaces="uap rescap com uap10">

  <Identity
    Name="VaultType.PasskeyProvider"
    Publisher="CN=VaultType Dev"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>VaultType</DisplayName>
    <PublisherDisplayName>VaultType</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.26100.6725" MaxVersionTested="10.0.26200.8875" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="VaultType"
      Executable="VaultType.exe"
      EntryPoint="Windows.FullTrustApplication"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="VaultType"
        Description="VaultType - Bitwarden/Vaultwarden auto-type, SSH agent and passkey provider"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="VaultType.exe" Arguments="-PluginActivated" DisplayName="VaultType Passkey Provider">
              <com:Class Id="2d201497-f4f9-4bf0-b3c7-c230d332788d" DisplayName="VaultType Passkey Provider" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
