<Window x:Class="VaultType.Views.SshKeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VaultType"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Title="VaultType"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}">

    <Border x:Name="Card" Width="460" Margin="16" Background="{StaticResource WindowBg}" CornerRadius="13" BorderBrush="#1FFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <Grid>
            <StackPanel>
                <!-- header -->
                <StackPanel Margin="22,18,22,14">
                    <TextBlock Text="{local:Tr ssh.title}" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold" />
                    <TextBlock x:Name="HeaderStatus" Foreground="{StaticResource TextHint}" FontSize="11.5" Margin="0,4,0,0" />
                </StackPanel>

                <!-- key list (max 300, scrolls) -->
                <ScrollViewer MaxHeight="300" Margin="12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel x:Name="KeyList" />
                        <StackPanel x:Name="EmptyState" Visibility="Collapsed" Margin="10,26,10,30">
                            <TextBlock x:Name="EmptyTitle" Text="{local:Tr ssh.emptyTitle}" Foreground="{StaticResource TextHint}" FontSize="12.5" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyMsg" Text="{local:Tr ssh.emptyMsg}" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- footer -->
                <Grid Margin="22,14,22,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LoadedText" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="{local:Tr common.done}" Click="Done_Click" />
                </Grid>
            </StackPanel>

            <!-- close button: card top-right corner (like the unlock dialog) -->
            <Button Style="{StaticResource CloseButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="Done_Click">
                <Viewbox Width="17" Height="17">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>
    </Border>
</Window>
