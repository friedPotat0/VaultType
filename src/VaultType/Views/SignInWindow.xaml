<Window x:Class="VaultType.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VaultType"
        xmlns:views="clr-namespace:VaultType.Views"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Title="VaultType"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}">

    <Border x:Name="Card" Width="430" Margin="16" Background="{StaticResource WindowBg}" CornerRadius="13" BorderBrush="#1FFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <Grid>
            <StackPanel Margin="22,18,22,24">
                <!-- header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,46,0">
                    <Rectangle Width="44" Height="44" VerticalAlignment="Center" Fill="{StaticResource LogoBrush}" />
                    <TextBlock Text="{local:Tr signin.title}" Foreground="#FFFFFF"
                               FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock Text="{local:Tr signin.hint}" Foreground="{StaticResource TextHint}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,10,0,0" />

                <!-- server dropdown trigger -->
                <ToggleButton x:Name="ServerTrigger" Style="{StaticResource DropdownTrigger}" Margin="0,18,0,0" Click="ServerTrigger_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ServerLabel" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center" />
                        <Viewbox Grid.Column="1" Width="18" Height="18" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconChevronDown}" Stroke="{StaticResource TextHint}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </ToggleButton>

                <!-- Server-URL (self-hosted only) -->
                <StackPanel x:Name="UrlGroup" Margin="0,18,0,0">
                    <TextBlock Text="{local:Tr signin.serverUrl}" Foreground="{StaticResource TextLabel}" FontSize="12.5" FontWeight="SemiBold" />
                    <Border Style="{StaticResource FieldBorder}" Margin="0,9,0,0">
                        <Grid Margin="16,0">
                            <TextBox x:Name="UrlBox" Style="{StaticResource PlainBox}" FontSize="13" TextChanged="AnyText_Changed" />
                            <TextBlock x:Name="UrlPlaceholder" Text="https://vault.example.com" Foreground="{StaticResource TextSecondary}"
                                       FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{local:Tr signin.serverUrlHint}" Foreground="{StaticResource TextHint}" FontSize="12" Margin="0,7,0,0" />
                </StackPanel>

                <!-- Anmeldemethode -->
                <StackPanel Margin="0,18,0,0">
                    <TextBlock Text="{local:Tr signin.method}" Foreground="{StaticResource TextLabel}" FontSize="12.5" FontWeight="SemiBold" />
                    <Border Style="{StaticResource SegGroup}" Margin="0,9,0,0">
                        <views:FlexRowPanel x:Name="MethodPills" Gap="4" />
                    </Border>
                </StackPanel>

                <!-- mode: API key -->
                <StackPanel x:Name="ApiGroup">
                    <TextBlock Text="{local:Tr signin.apiHint}" Foreground="{StaticResource TextHint}" FontSize="12"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,16,0,0" />
                    <TextBlock Text="{local:Tr signin.clientId}" Foreground="{StaticResource TextLabel}" FontSize="12.5" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <Border Style="{StaticResource FieldBorder}" Margin="0,9,0,0">
                        <Grid Margin="16,0">
                            <TextBox x:Name="ClientIdBox" Style="{StaticResource PlainBox}" FontSize="13" TextChanged="AnyText_Changed" />
                            <TextBlock x:Name="ClientIdPlaceholder" Text="user.xxxxxxxx" Foreground="{StaticResource TextSecondary}"
                                       FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{local:Tr signin.clientSecret}" Foreground="{StaticResource TextLabel}" FontSize="12.5" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <Border Style="{StaticResource FieldBorder}" Margin="0,9,0,0">
                        <Grid Margin="16,0">
                            <PasswordBox x:Name="ClientSecretBox" Style="{StaticResource PlainPasswordBox}" PasswordChanged="AnyPw_Changed" />
                            <TextBlock x:Name="ClientSecretPlaceholder" Text="{local:Tr signin.clientSecretPlaceholder}" Foreground="{StaticResource TextSecondary}"
                                       FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- mode: SSO -->
                <StackPanel x:Name="SsoGroup">
                    <TextBlock Text="{local:Tr signin.ssoHint}" Foreground="{StaticResource TextHint}" FontSize="12"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,16,0,0" />
                    <TextBlock Text="{local:Tr signin.ssoOrg}" Foreground="{StaticResource TextLabel}" FontSize="12.5" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <Border Style="{StaticResource FieldBorder}" Margin="0,9,0,0">
                        <Grid Margin="16,0">
                            <TextBox x:Name="SsoBox" Style="{StaticResource PlainBox}" FontSize="13" TextChanged="AnyText_Changed" />
                            <TextBlock x:Name="SsoPlaceholder" Text="{local:Tr signin.ssoPlaceholder}" Foreground="{StaticResource TextSecondary}"
                                       FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <!-- Vaultwarden warning -->
                    <Border x:Name="SsoWarn" Margin="0,12,0,0" CornerRadius="10" Padding="12,10"
                            Background="#1AD29922" BorderBrush="#47D29922" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,9,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 3 2 20 H22 Z" Stroke="#E3B341" StrokeThickness="1.7" StrokeLineJoin="Round" />
                                    <Path Data="M12 10 V14" Stroke="#E3B341" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Ellipse Canvas.Left="10.95" Canvas.Top="15.95" Width="2.1" Height="2.1" Fill="#E3B341" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="{local:Tr signin.ssoVwWarn}" Foreground="#D9A441" FontSize="12"
                                       TextWrapping="Wrap" LineHeight="17.4" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- mode: device approval -->
                <StackPanel x:Name="DeviceGroup">
                    <TextBlock Text="{local:Tr signin.email}" Foreground="{StaticResource TextLabel}" FontSize="12.5" FontWeight="SemiBold" Margin="0,18,0,0" />
                    <Border Style="{StaticResource FieldBorder}" Margin="0,9,0,0">
                        <Grid Margin="16,0">
                            <TextBox x:Name="DevEmailBox" Style="{StaticResource PlainBox}" FontSize="13" TextChanged="AnyText_Changed" />
                            <TextBlock x:Name="DevEmailPlaceholder" Text="name@example.com" Foreground="{StaticResource TextSecondary}"
                                       FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <Border Margin="0,16,0,0" CornerRadius="13" Padding="16,14" Background="{StaticResource Field}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{local:Tr signin.deviceHint}" Foreground="{StaticResource TextHint}" FontSize="12"
                                       TextWrapping="Wrap" LineHeight="18" />
                            <TextBlock Text="{local:Tr signin.devicePhrase}" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" />
                            <TextBlock x:Name="DevicePhrase" Text="–" Foreground="#7EE787" FontFamily="{StaticResource MonoFont}"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- mode: passkey -->
                <TextBlock x:Name="PasskeyHint" Text="{local:Tr signin.passkeyHint}" Foreground="{StaticResource TextHint}" FontSize="12"
                           TextWrapping="Wrap" LineHeight="18" Margin="0,16,0,0" />

                <!-- account e-mail (email / apikey) - it is the KDF salt, so the API-key grant needs it too -->
                <StackPanel x:Name="EmailGroup">
                    <TextBlock Text="{local:Tr signin.email}" Foreground="{StaticResource TextLabel}" FontSize="12.5" FontWeight="SemiBold" Margin="0,18,0,0" />
                    <Border Style="{StaticResource FieldBorder}" Margin="0,9,0,0">
                        <Grid Margin="16,0">
                            <TextBox x:Name="EmailBox" Style="{StaticResource PlainBox}" FontSize="13" TextChanged="AnyText_Changed" />
                            <TextBlock x:Name="EmailPlaceholder" Text="name@example.com" Foreground="{StaticResource TextSecondary}"
                                       FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- mode: email -->
                <StackPanel x:Name="TwofaGroup">
                    <TextBlock Text="{local:Tr signin.twofa}" Foreground="{StaticResource TextLabel}" FontSize="12.5" FontWeight="SemiBold" Margin="0,18,0,0" />
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="TwofaTrigger" Grid.Column="0" Style="{StaticResource DropdownTrigger}" Click="TwofaTrigger_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TwofaLabel" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center" />
                                <Viewbox Grid.Column="1" Width="16" Height="16" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource IconChevronDown}" Stroke="{StaticResource TextHint}"
                                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </ToggleButton>
                        <Border Grid.Column="2" Style="{StaticResource FieldBorder}">
                            <Grid Margin="16,0">
                                <TextBox x:Name="TwofaCodeBox" Style="{StaticResource PlainBox}" FontSize="13" TextChanged="AnyText_Changed" />
                                <TextBlock x:Name="TwofaCodePlaceholder" Text="{local:Tr signin.codePlaceholder}" Foreground="{StaticResource TextSecondary}"
                                           FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- master password (email / apikey / sso) -->
                <StackPanel x:Name="MasterGroup">
                    <TextBlock Text="{local:Tr unlock.master}" Foreground="{StaticResource TextLabel}" FontSize="12.5" FontWeight="SemiBold" Margin="0,22,0,0" />
                    <Border Style="{StaticResource FieldBorder}" Margin="0,9,0,0">
                        <Grid Margin="18,0">
                            <PasswordBox x:Name="Pw" Style="{StaticResource PlainPasswordBox}" PasswordChanged="AnyPw_Changed" KeyDown="Pw_KeyDown" />
                            <TextBlock x:Name="PwPlaceholder" Text="{local:Tr unlock.masterPlaceholder}" Foreground="{StaticResource TextSecondary}"
                                       FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Künftig entsperren mit -->
                <StackPanel Margin="0,22,0,0">
                    <TextBlock Text="{local:Tr signin.prefUnlock}" Foreground="{StaticResource TextLabel}" FontSize="12.5" FontWeight="SemiBold" />
                    <Border Style="{StaticResource SegGroup}" Margin="0,9,0,0">
                        <views:FlexRowPanel x:Name="UnlockPills" Gap="4" />
                    </Border>
                </StackPanel>

                <!-- PIN festlegen (pref = pin) -->
                <StackPanel x:Name="PinGroup">
                    <TextBlock Text="{local:Tr signin.setPin}" Foreground="{StaticResource TextLabel}" FontSize="12.5" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <Border Style="{StaticResource FieldBorder}" Margin="0,9,0,0">
                        <Grid Margin="18,0">
                            <PasswordBox x:Name="PinBox" Style="{StaticResource PlainPasswordBox}" FontFamily="{StaticResource MonoFont}" FontSize="12" PasswordChanged="AnyPw_Changed" />
                            <TextBlock x:Name="PinPlaceholder" Text="{local:Tr signin.pinPlaceholder}" Foreground="{StaticResource TextSecondary}"
                                       FontSize="13" FontFamily="{StaticResource AppFont}" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <!-- 20px checkbox row -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Cursor="Hand" MouseLeftButtonDown="RestartLock_Click" Background="Transparent">
                        <Border x:Name="RestartLockBox" Width="20" Height="20" CornerRadius="6" VerticalAlignment="Center"
                                Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" BorderThickness="1.5">
                            <Path x:Name="RestartLockCheck" Data="M5,11.5 L9,15.5 L15.5,7" Stroke="{StaticResource OnAccent}" StrokeThickness="2.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="12" Height="12" />
                        </Border>
                        <TextBlock Text="{local:Tr signin.restartLock}" Foreground="{StaticResource TextLabel}" FontSize="12.5"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Anzeige (avatar + vault name) -->
                <StackPanel Margin="0,22,0,0">
                    <TextBlock Text="{local:Tr signin.display}" Foreground="{StaticResource TextLabel}" FontSize="12.5" FontWeight="SemiBold" />
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="11" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AvatarBtn" Grid.Column="0" Click="Avatar_Click" Cursor="Hand"
                                ToolTip="{local:Tr signin.avatarTooltip}" Background="Transparent">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="AvatarSwatch" Width="46" Height="46" CornerRadius="12" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="AvatarInitial" Text="?" Foreground="#F4F6F8" FontSize="17" FontWeight="Bold" />
                        </Button>
                        <Border Grid.Column="2" Style="{StaticResource FieldBorder}">
                            <Grid Margin="14,0">
                                <TextBox x:Name="VaultNameBox" Style="{StaticResource PlainBox}" FontSize="13" TextChanged="VaultName_Changed" />
                                <TextBlock x:Name="VaultNamePlaceholder" Text="{local:Tr signin.vaultNamePlaceholder}" Foreground="{StaticResource TextSecondary}"
                                           FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock Text="{local:Tr signin.avatarHint}" Foreground="{StaticResource TextHint}" FontSize="12" Margin="0,7,0,0" />
                </StackPanel>

                <TextBlock x:Name="Error" Foreground="{StaticResource Danger}" FontSize="12" TextWrapping="Wrap"
                           Margin="0,10,0,0" Visibility="Collapsed" />

                <!-- submit -->
                <Button x:Name="OkBtn" Style="{StaticResource PrimaryButtonLarge}" Margin="0,18,0,0" IsDefault="True" Click="Ok_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M15 3 H19 A2 2 0 0 1 21 5 V19 A2 2 0 0 1 19 21 H15 M10 17 L15 12 L10 7 M15 12 H3"
                                      Stroke="{StaticResource OnAccent}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="OkLabel" Text="{local:Tr signin.btn}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- close -->
            <Button x:Name="CloseBtn" Style="{StaticResource CloseButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="Cancel_Click">
                <Viewbox Width="17" Height="17">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- dropdown overlay (server / 2FA); the Canvas keeps the menu out of the layout
                 measure, so an open dropdown overflows instead of growing the window -->
            <Grid x:Name="Overlay" Visibility="Collapsed">
                <Rectangle Fill="Transparent" MouseDown="Backdrop_Click" />
                <Canvas>
                    <Border x:Name="DropdownMenu" Style="{StaticResource DropdownPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DropdownItems" />
                        </ScrollViewer>
                    </Border>
                </Canvas>
            </Grid>
        </Grid>
    </Border>
</Window>
