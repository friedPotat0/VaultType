<Window x:Class="VaultType.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VaultType"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" Title="VaultType"
        SizeToContent="Height" Width="460" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}">

    <Border Margin="16" Background="{StaticResource WindowBg}" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="26,20,26,22">
            <!-- Header -->
            <Grid x:Name="TitleBar" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="24" Height="24" VerticalAlignment="Center" Fill="{StaticResource LogoBrush}" />
                    <TextBlock VerticalAlignment="Center" Margin="9,0,0,0">
                        <Run Text="VaultType" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" />
                        <Run Text=" " />
                        <Run x:Name="VersionRun" Foreground="{StaticResource TextMuted}" FontSize="11" />
                    </TextBlock>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Cancel_Click" />
            </Grid>

            <Grid Margin="0,16,0,4">
                <TextBlock Text="{local:Tr settings.title}" Foreground="{StaticResource TextPrimary}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="{local:Tr settings.reset}" Style="{StaticResource GhostButton}" Click="Reset_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Height="30" FontSize="11.5" />
            </Grid>

            <!-- Connection -->
            <TextBlock Text="{local:Tr settings.connection}" Foreground="{StaticResource TextMuted}" FontSize="10.5" FontWeight="SemiBold" Margin="0,14,0,8" />
            <Button Content="{local:Tr settings.changeLogin}" Style="{StaticResource GhostButton}" Click="ChangeLogin_Click"
                    HorizontalAlignment="Left" Height="34" />
            <TextBlock Text="{local:Tr settings.changeLoginHint}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="2,5,0,0" />
            <TextBlock Text="{local:Tr settings.hotkey}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="2,12,0,5" />
            <Border Style="{StaticResource FieldBorder}">
                <TextBox x:Name="HotkeyBox" Style="{StaticResource PlainBox}" IsReadOnly="True" Margin="12,0" />
            </Border>
            <TextBlock Text="{local:Tr settings.hotkeyHint}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="2,4,0,0" />

            <!-- Behavior -->
            <TextBlock Text="{local:Tr settings.behavior}" Foreground="{StaticResource TextMuted}" FontSize="10.5" FontWeight="SemiBold" Margin="0,20,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{local:Tr settings.autolock}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="2,0,0,5" TextTrimming="CharacterEllipsis" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid Margin="12,0,12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="IdleBox" Grid.Column="0" Style="{StaticResource PlainBox}" />
                            <TextBlock Grid.Column="1" Text="min" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{local:Tr settings.clipclear}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="2,0,0,5" TextTrimming="CharacterEllipsis" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid Margin="12,0,12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ClipBox" Grid.Column="0" Style="{StaticResource PlainBox}" />
                            <TextBlock Grid.Column="1" Text="s" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="{local:Tr settings.typedelay}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="2,0,0,5" TextTrimming="CharacterEllipsis" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Grid Margin="12,0,12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="DelayBox" Grid.Column="0" Style="{StaticResource PlainBox}" />
                            <TextBlock Grid.Column="1" Text="ms" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <CheckBox x:Name="ClearFieldChk" Content="{local:Tr settings.clearField}" Margin="0,16,0,0" />
            <CheckBox x:Name="AutostartChk" Content="{local:Tr settings.autostart}" Margin="0,12,0,0" />
            <CheckBox x:Name="TrayClickChk" Content="{local:Tr settings.trayClick}" Margin="0,12,0,0"
                      ToolTip="{local:Tr settings.trayClickHint}" />

            <!-- URL match -->
            <TextBlock Text="{local:Tr settings.uriMatch}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="2,18,0,5" />
            <ComboBox x:Name="UriMatchBox" />
            <TextBlock Text="{local:Tr settings.uriMatchHint}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="2,5,0,0" />

            <!-- Language -->
            <TextBlock Text="{local:Tr settings.language}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="2,18,0,5" />
            <ComboBox x:Name="LangBox" />

            <!-- Security -->
            <TextBlock Text="{local:Tr settings.security}" Foreground="{StaticResource TextMuted}" FontSize="10.5" FontWeight="SemiBold" Margin="0,20,0,8" />
            <CheckBox x:Name="ExcludeCapChk" Content="{local:Tr settings.hideCapture}" />
            <CheckBox x:Name="AntiDbgChk" Content="{local:Tr settings.antiDebug}" Margin="0,12,0,0" />

            <!-- Footer -->
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="{local:Tr common.cancel}" Style="{StaticResource GhostButton}" Click="Cancel_Click" MinWidth="96" />
                <Button Grid.Column="3" Content="{local:Tr common.save}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" MinWidth="120" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
