<Window x:Class="VaultType.Views.CliSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VaultType"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="Height" Width="452" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        FontFamily="{StaticResource AppFont}">

    <Border Margin="16" Background="{StaticResource WindowBg}" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="26,22,26,24">
            <Grid x:Name="TitleBar" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="24" Height="24" VerticalAlignment="Center" Fill="{StaticResource LogoBrush}" />
                    <TextBlock Text="VaultType" Foreground="{StaticResource TextPrimary}"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{local:Tr cli.title}" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBlock Text="{local:Tr cli.body}" Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" LineHeight="19" />

            <!-- Automatic download -->
            <Button Content="{local:Tr cli.download}" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Click="Download_Click" />
            <TextBlock x:Name="SourceHint" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0" />

            <!-- Provide it yourself -->
            <Button Content="{local:Tr cli.selectFile}" Style="{StaticResource GhostButton}" Margin="0,16,0,0" Click="Select_Click" />
            <TextBlock x:Name="ManualHint" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0" />

            <Button Content="{local:Tr common.cancel}" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="96" Click="Cancel_Click" />
        </StackPanel>
    </Border>
</Window>
