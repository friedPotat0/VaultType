<Window x:Class="VaultType.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Title="VaultType"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}">

    <Border Margin="16" Background="{StaticResource WindowBg}" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" Margin="26,22">
            <Grid Width="28" Height="28" VerticalAlignment="Center">
                <Ellipse Width="28" Height="28" Stroke="{StaticResource Border}" StrokeThickness="3" />
                <Ellipse Width="28" Height="28" Stroke="{StaticResource Accent}" StrokeThickness="3"
                         StrokeDashArray="7.3 22" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="Rot" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <TextBlock x:Name="StatusText" Text="Working ..." Foreground="{StaticResource TextPrimary}"
                       FontSize="14" VerticalAlignment="Center" Margin="16,0,4,0" />
        </StackPanel>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Rot" Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
