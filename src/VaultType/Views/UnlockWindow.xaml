<Window x:Class="VaultType.Views.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VaultType"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="Height" Width="400" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}">

    <Border Margin="16" Background="{StaticResource WindowBg}" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="26,22,26,24">
            <Grid x:Name="TitleBar" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="26" Height="26" VerticalAlignment="Center" Fill="{StaticResource LogoBrush}" />
                    <TextBlock Text="VaultType" Foreground="{StaticResource TextPrimary}"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <Button x:Name="CloseBtn" Style="{StaticResource IconButton}" Content="&#xE711;"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="Cancel_Click" />
            </Grid>

            <TextBlock x:Name="Heading" Text="Unlock vault" Foreground="{StaticResource TextPrimary}"
                       FontSize="20" FontWeight="SemiBold" Margin="0,18,0,2" />
            <TextBlock x:Name="Subtitle" Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                       TextWrapping="Wrap" Margin="0,0,0,18" />

            <StackPanel x:Name="AccountTypeGroup" Margin="0,0,0,14">
                <ComboBox x:Name="AccountBox" SelectedIndex="0" SelectionChanged="Account_Changed">
                    <ComboBoxItem Content="Vaultwarden (self-hosted)" />
                    <ComboBoxItem Content="Bitwarden.com" />
                </ComboBox>
            </StackPanel>

            <StackPanel x:Name="ServerGroup">
                <TextBlock Text="{local:Tr unlock.server}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="2,0,0,6" />
                <TextBox x:Name="ServerBox" Style="{StaticResource SearchBox}" />
                <TextBlock Text="{local:Tr unlock.serverHint}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="2,4,0,14" />
            </StackPanel>

            <CheckBox x:Name="ApiKeyChk" Content="{local:Tr unlock.useApiKey}" Margin="0,0,0,14"
                      Checked="ApiKey_Changed" Unchecked="ApiKey_Changed" />

            <TextBlock x:Name="ApiHint" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,14"
                       Text="{local:Tr unlock.apiHint}" />

            <StackPanel x:Name="EmailGroup">
                <TextBlock Text="{local:Tr unlock.email}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="2,0,0,6" />
                <TextBox x:Name="EmailBox" Style="{StaticResource SearchBox}" Margin="0,0,0,14" />
            </StackPanel>

            <StackPanel x:Name="ClientIdGroup">
                <TextBlock Text="{local:Tr unlock.clientId}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="2,0,0,6" />
                <TextBox x:Name="ClientIdBox" Style="{StaticResource SearchBox}" Margin="0,0,0,14" />
            </StackPanel>

            <StackPanel x:Name="ClientSecretGroup">
                <TextBlock Text="{local:Tr unlock.clientSecret}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="2,0,0,6" />
                <PasswordBox x:Name="ClientSecretBox" Style="{StaticResource PasswordBoxStyle}" Margin="0,0,0,14" />
            </StackPanel>

            <TextBlock Text="{local:Tr unlock.master}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="2,0,0,6" />
            <PasswordBox x:Name="Pw" Style="{StaticResource PasswordBoxStyle}" KeyDown="Pw_KeyDown" />

            <StackPanel x:Name="TwoFactorGroup">
                <TextBlock Text="{local:Tr unlock.twofa}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="2,12,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="MethodBox" Grid.Column="0" SelectedIndex="0">
                        <ComboBoxItem Content="Authenticator" />
                        <ComboBoxItem Content="Email" />
                        <ComboBoxItem Content="YubiKey" />
                    </ComboBox>
                    <Border Grid.Column="2" Style="{StaticResource FieldBorder}">
                        <TextBox x:Name="TwoFactorBox" Style="{StaticResource PlainBox}" Margin="12,0" />
                    </Border>
                </Grid>
            </StackPanel>

            <TextBlock x:Name="Error" Foreground="{StaticResource Danger}" FontSize="12" TextWrapping="Wrap"
                       Margin="2,10,0,0" Visibility="Collapsed" />

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{local:Tr common.cancel}" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button x:Name="OkBtn" Grid.Column="2" Content="Unlock" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="Ok_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
