<Window x:Class="VaultType.Views.VaultViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VaultType"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" Title="VaultType"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}">

    <Border Width="380" Height="520" Margin="16" Background="{StaticResource WindowBg}" CornerRadius="13" BorderBrush="#1FFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="20,16,52,10">
                <TextBlock Text="{local:Tr viewer.title}" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" />
                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextHint}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <Grid x:Name="SearchRow" Grid.Row="1" Margin="14,0,14,8">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" FontSize="13" Padding="10,7"
                         TextChanged="Search_TextChanged" />
                <TextBlock Text="{local:Tr viewer.search}" Foreground="{StaticResource TextMuted}" FontSize="13"
                           Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <ScrollViewer x:Name="ListScroll" Grid.Row="2" Margin="8,0,8,10"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel x:Name="EntryList" />
                    <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextHint}" FontSize="12.5"
                               HorizontalAlignment="Center" Margin="10,30,10,0" TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="DetailScroll" Grid.Row="1" Grid.RowSpan="2" Margin="8,0,8,10" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DetailPanel" />
            </ScrollViewer>

            <Button Grid.RowSpan="3" Style="{StaticResource CloseButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click">
                <Viewbox Width="17" Height="17">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>
    </Border>
</Window>
