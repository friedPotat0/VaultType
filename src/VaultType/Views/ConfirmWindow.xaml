<Window x:Class="VaultType.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VaultType"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Title="VaultType"
        SizeToContent="Height" Width="410" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}">

    <Border Margin="16" Background="{StaticResource WindowBg}" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <Grid>
            <StackPanel Margin="26,22,26,24">
                <Grid x:Name="TitleBar" Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="24" Height="24" VerticalAlignment="Center" Fill="{StaticResource LogoBrush}" />
                        <TextBlock Text="VaultType" Foreground="{StaticResource TextPrimary}"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="Heading" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,4" />
                <TextBlock x:Name="Message" Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" LineHeight="19" />

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NoBtn" Grid.Column="0" Content="{local:Tr common.no}" Style="{StaticResource GhostButton}" Click="No_Click" />
                    <Button x:Name="YesBtn" Grid.Column="2" Content="{local:Tr common.yes}" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Click="Yes_Click" />
                </Grid>
            </StackPanel>

            <!-- close button: card top-right corner (like the unlock dialog) -->
            <Button Style="{StaticResource CloseButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="No_Click">
                <Viewbox Width="17" Height="17">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>
    </Border>
</Window>
