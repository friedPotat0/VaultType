<Window x:Class="VaultType.Views.CliDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VaultType"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height" Width="440" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}">

    <Border Margin="16" Background="{StaticResource WindowBg}" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="26,22,26,22">
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="24" Height="24" VerticalAlignment="Center" Fill="{StaticResource LogoBrush}" />
                <TextBlock Text="VaultType" Foreground="{StaticResource TextPrimary}"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0" />
            </StackPanel>

            <TextBlock Text="{local:Tr cli.dlTitle}" Foreground="{StaticResource TextPrimary}"
                       FontSize="18" FontWeight="SemiBold" Margin="0,16,0,16" />

            <!-- Progress bar + percentage -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="Bar" Grid.Column="0" Height="10" Minimum="0" Maximum="100" VerticalAlignment="Center">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    CornerRadius="5" ClipToBounds="True">
                                <Grid>
                                    <Border x:Name="PART_Track" />
                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                            Background="{StaticResource Accent}" CornerRadius="5" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <TextBlock x:Name="Percent" Grid.Column="1" Text="0%" Foreground="{StaticResource TextPrimary}"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           MinWidth="44" TextAlignment="Right" Margin="12,0,0,0" />
            </Grid>

            <!-- Size on the left, speed / ETA on the right -->
            <Grid Margin="0,11,0,0">
                <TextBlock x:Name="SizeText" HorizontalAlignment="Left" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                <TextBlock x:Name="RateText" HorizontalAlignment="Right" Foreground="{StaticResource TextMuted}" FontSize="12" />
            </Grid>

            <TextBlock x:Name="SourceText" Foreground="{StaticResource TextMuted}" FontSize="11"
                       TextTrimming="CharacterEllipsis" Margin="0,12,0,0" />

            <Button Content="{local:Tr common.cancel}" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="96" Click="Cancel_Click" />
        </StackPanel>
    </Border>
</Window>
